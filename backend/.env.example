GEMINI_API_KEY=your_gemini_api_key_here

# Supabase project REST API (Project Settings -> API)
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Direct Postgres connection string, used only by backend/scripts/init_supabase.py to run DDL
# (Project Settings -> Database -> Connection string -> URI; use the session-mode pooler /
# "used for migrations" variant). The service-role REST key above cannot execute CREATE TABLE
# statements, so this separate credential is required for schema setup.
DATABASE_URL=your_supabase_postgres_connection_string_here
